# Salin menjadi .env, isi nilainya, lalu jalankan: python scripts/build.py env
# PERINGATAN: nilai di sini ikut tertulis ke js/env.js dan terbaca oleh siapa pun yang bisa membuka halaman.
# Pakai hanya untuk penggunaan pribadi/lokal. Jangan di-deploy ke publik.

# Kunci API. Pola: LUNA_<ID PROVIDER>_API_KEY (ID = nama kunci di objek P pada js/config.js, huruf besar)
LUNA_OPENAI_API_KEY=
LUNA_ANTHROPIC_API_KEY=
LUNA_GOOGLE_API_KEY=
LUNA_OPENROUTER_API_KEY=
LUNA_GROQ_API_KEY=

# URL kustom (opsional). Pola: LUNA_<ID>_URL
LUNA_OLLAMA_URL=http://localhost:11434/v1
LUNA_LMSTUDIO_URL=http://localhost:1234/v1

# Model awal per mode. Format: provider:model
# Mode: CHAT, MULTIMODAL (model yang menerima gambar), RESEARCH, IMAGE, VIDEO
LUNA_DEFAULT_CHAT=ollama:llama3.2
LUNA_DEFAULT_MULTIMODAL=ollama:llava
LUNA_DEFAULT_IMAGE=openai:gpt-image-1
LUNA_DEFAULT_VIDEO=google:veo-3.0-generate-001
