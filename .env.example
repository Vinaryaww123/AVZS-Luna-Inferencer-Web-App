# Copy to .env, fill in the values, then run: python scripts/build.py env
# WARNING: values here are also written to js/env.js and are readable by anyone who can open the page.
# Use only for personal/local use. Do not deploy publicly.

# API keys. Pattern: LUNA_<PROVIDER_ID>_API_KEY (ID = key name in the P object in js/config.js, uppercase)
LUNA_OPENAI_API_KEY=
LUNA_ANTHROPIC_API_KEY=
LUNA_GOOGLE_API_KEY=
LUNA_OPENROUTER_API_KEY=
LUNA_GROQ_API_KEY=

# Custom URLs (optional). Pattern: LUNA_<ID>_URL
LUNA_OLLAMA_URL=http://localhost:11434/v1
LUNA_LMSTUDIO_URL=http://localhost:1234/v1

# Initial model per mode. Format: provider:model
# Modes: CHAT, CODER, AGENT, MULTIMODAL (model that accepts images), RESEARCH, IMAGE, VIDEO
# Example with the built-in in-app runtime (the model downloads on first use):
# LUNA_DEFAULT_AGENT=inapp:qwen2.5-1.5b
LUNA_DEFAULT_CHAT=ollama:llama3.2
LUNA_DEFAULT_MULTIMODAL=ollama:llava
LUNA_DEFAULT_IMAGE=openai:gpt-image-1
LUNA_DEFAULT_VIDEO=google:veo-3.0-generate-001
